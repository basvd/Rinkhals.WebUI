{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "rinkhals-webui/src",
    "rinkhals-webui/scripts"
  ],
  "ignore": [
    "rinkhals-webui/src/microdot"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "rinkhals-webui/src"
      ]
    }
  ],
  // Micropython type stubs have no source
  "reportMissingModuleSource": "none"
}
